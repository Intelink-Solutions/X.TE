APP_NAME="X'Touch Entertainment"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://xtouchentertainments.com
FRONTEND_URL=https://xtouchentertainments.com
CORS_ALLOWED_ORIGINS=https://xtouchentertainments.com,https://www.xtouchentertainments.com
SANCTUM_STATEFUL_DOMAINS=xtouchentertainments.com,www.xtouchentertainments.com
APP_TIMEZONE=Africa/Lagos
# Set * only when the application is behind a trusted load balancer or CDN.
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xtouch
DB_USERNAME=xtouch
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.xtouchentertainments.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
PUBLIC_STORAGE_PATH=/home/CPANEL_USER/xtouchentertainments.com/storage
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=mail.xtouchentertainments.com
MAIL_PORT=587
MAIL_USERNAME=info@xtouchentertainments.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@xtouchentertainments.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SUBMISSIONS_TO=xtouchentertainments@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Set these only while creating the first control panel account. Use a unique password.
INITIAL_CONTROL_PANEL_NAME="X'Touch Site Owner"
INITIAL_CONTROL_PANEL_EMAIL=
INITIAL_CONTROL_PANEL_PASSWORD=
